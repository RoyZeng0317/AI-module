# Python 虛擬環境
.venv/
venv/
env/

# 環境變數／金鑰（不可進版控）
.env
**/.env

# Python 編譯快取
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# CLI 執行紀錄
lib/components/.cli_history

# /resume 用的對話自動存檔（含實際聊天內容，不進版控）
memory/session.json

# /chat 下載出來的對話 Markdown 檔（含實際聊天內容，不進版控）
output/chats/

# 桌面 GUI／CLI／網頁側邊欄共用的「對話紀錄」存檔（含實際聊天內容，不進版控）
memory/conversations.json

# usage_store.py 的字元用量紀錄（web/backend/test_app.py 的 TestClient 沒有
# 完全隔離 _resolve_path()，先前跑測試時意外把 "testclient" 這個假 IP 的
# 用量寫進這份原本有被 git 追蹤的檔案——這本來就是跟 session.json/
# conversations.json 同類的執行期產物，不該進版控，加進來避免每次跑測試
# 都看到這份檔案被標成已修改）
memory/usage.json

# 可重新下載/重新產生的訓練資料與訓練產物（不進版控）
tranning/commonvoice_zhTW/
tranning/gpt_chat_runs/
tranning/gpt_pretrain_runs/
tranning/gpt_code_pretrain_runs/
tranning/dist/
tranning/speech_runs/
tranning/speech_data/
tranning/Tranning/

# lib/IndexTTS2.py（/model nvidia 的同類 Rule 06 例外）用到的外部開源模型本體——
# git clone 下來的 index-tts 原始碼跟 modelscope 下載的 checkpoint 都是數 GB
# 的第三方內容，不是本專案自己的程式碼/訓練產物，不進版控
lib/index-tts/
lib/indextts2_checkpoints/

# nova 指令的 PyInstaller 打包產物（可用 pyinstaller 重新產生，機器相依、體積大，不進版控）
/nova.exe
/build/pyinstaller/
